PUME_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# LAN IPs are detected from the live network interfaces, so leave this empty
# unless you need to allow a host that cannot be detected, such as a tunnel
# domain. 전시 데모에서는 비워두세요.
DEV_ALLOWED_ORIGINS=
# Public origin encoded in keepsake QR links. Leave empty for a LAN demo: the
# QR uses the address the booth browser is open at, and falls back to the
# detected LAN IP. Set this only when the site is served from a fixed public
# origin. 하드코딩한 IP는 와이파이가 바뀌는 순간 QR이 깨지므로 비워두세요.
NEXT_PUBLIC_APP_URL=
