# Both A/B pipeline arms use this same Gemini configuration.
GEMINI_AUTH_MODE=vertex_adc
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# api_key mode fallback only. Keep the real key only in .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Optional override for vertex_adc mode. Usually leave empty so the project and
# location above produce the official Vertex OpenAI-compatible endpoint.
GEMINI_VERTEX_BASE_URL=
# Low reasoning minimizes latency; Gemini 3.5 thinking cannot be fully disabled.
GEMINI_REASONING_EFFORT=low
# A: one empathy-only opening writer (minimal) and one integrated current-slot
# analyzer (low). On shared API capacity, opening is published before analysis;
# with a physically separate analyzer API, both calls run in parallel. Runtime
# selects a reviewed aside phrase. Questions and ordering are deterministic.
BASELINE_RESPONSE_THINKING_LEVEL=minimal
BASELINE_ANALYZER_REASONING_EFFORT=low
# Failure ceilings, not intentional waits. Successful segments publish immediately.
BASELINE_RESPONSE_TIMEOUT_SECONDS=4.0
BASELINE_ANALYZER_TIMEOUT_SECONDS=4.0
# Stream/TTS path speaks a reviewed fallback by this deadline if opening stalls.
BASELINE_OPENING_LEAD_TIMEOUT_SECONDS=1.8
# At most one contextual aside every three counseling turns.
BASELINE_ASIDE_COOLDOWN_TURNS=3
# A only: retrieve a reviewed principle from the startup memory snapshot.
# "shadow" measures retrieval without showing it; "off" disables it.
BASELINE_PRINCIPLE_MODE=on
BASELINE_PRINCIPLE_REFERENCE_ENABLED=false
PRINCIPLE_DB_PATH=data/principle_bank.sqlite3
PRINCIPLE_MIN_SCORE=2.0
PRINCIPLE_EARLY_MIN_SCORE=4.5
# Optimized response generation stays on the primary route with minimal thinking.
# The analyzer has its own logical route; until explicitly enabled below it safely
# inherits the primary Gemini connection.
OPTIMIZED_ANALYZER_API_ROUTE=analyzer
OPTIMIZED_ANALYZER_REASONING_EFFORT=low
OPTIMIZED_RESPONSE_API_ROUTE=primary
OPTIMIZED_RESPONSE_THINKING_LEVEL=minimal

# Optional physically separate analyzer API/project. Keep disabled until the
# secondary account has working quota. Omitted ANALYZER_* values inherit primary.
ANALYZER_API_ENABLED=false
# ANALYZER_GEMINI_AUTH_MODE=api_key
# ANALYZER_GEMINI_API_KEY=
# ANALYZER_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# ANALYZER_GEMINI_VERTEX_BASE_URL=
# ANALYZER_GEMINI_MODEL=gemini-3.5-flash
# ANALYZER_GOOGLE_CLOUD_PROJECT=
# ANALYZER_GOOGLE_CLOUD_LOCATION=global

MODEL_TEMPERATURE=0.3
MODEL_MAX_TOKENS=600
# The upstream final insight report can exceed 600 tokens.
MODEL_INSIGHT_MAX_TOKENS=4096
MODEL_MAX_ATTEMPTS=2
MODEL_TIMEOUT_SECONDS=60
TARGET_ANALYZER_TIMEOUT_SECONDS=3.5
OPTIMIZED_RESPONSE_TIMEOUT_SECONDS=4.0
RAPPORT_TIMEOUT_SECONDS=3.0

# Text-only A/B boundary after the baseline's immediate acknowledgement. Once
# TTS is connected, replace this timer with that acknowledgement's audio_near_end event.
BASELINE_BRIDGE_DELAY_MS=2200

# Metrics are always logged. Conversation text is redacted unless explicitly enabled.
AB_RESULTS_PATH=runs/gemini_pipeline_ab_results.jsonl
AB_LOG_CONTENT=false

# UI/test-only mode. Never treat mock timings as model benchmark results.
AB_MOCK_MODE=false
MOCK_GEMINI_DELAY_MS=30

# Browser microphone -> local whisper.cpp STT. Install ffmpeg and pre-download
# the model with: .venv/bin/python scripts/download_stt.py small
STT_ENABLED=true
STT_MODEL_NAME=small
STT_LANGUAGE=ko
# CPU is the tested default on this Mac; enable only after verifying Metal.
STT_USE_GPU=false
STT_MAX_AUDIO_SECONDS=60
STT_MAX_UPLOAD_BYTES=16777216

# Browser TTS -> mgusdn/chatbot-voice compatible GPT-SoVITS API.
# The GPT-SoVITS API and selected weights must already be running on :9880.
TTS_ENABLED=true
TTS_SERVER_URL=http://127.0.0.1:9880
TTS_REF_AUDIO_PATH=/absolute/path/to/reference.wav
TTS_REF_TEXT=참조 음성에서 실제로 말한 문장을 정확히 입력하세요.
TTS_STREAMING_MODE=3
TTS_SEED=1234
TTS_TOP_K=5
TTS_MEDIA_TYPE=raw
TTS_FRAGMENT_INTERVAL_SECONDS=0
TTS_TEXT_SPLIT_METHOD=cut0
TTS_TICKET_TTL_SECONDS=90

# Public commons traces are isolated from counseling data and expire after 24-30 hours.
COMMONS_DB_PATH=data/commons.sqlite3
COMMONS_TTL_HOURS=30
# Persistent shared memory room. Keep DATABASE_URL server-side only.
MEMORY_DATABASE_BACKEND=sqlite
# DATABASE_URL=postgresql://postgres.project:password@region.pooler.supabase.com:5432/postgres?sslmode=require
MEMORY_DB_PATH=data/memories.sqlite3

# Keepsake letter store. Defaults to MEMORY_DATABASE_BACKEND.
# For multi-machine demos, use postgres so letters are shared across devices.
# KEEPSAKE_DATABASE_BACKEND=postgres
# KEEPSAKE_DB_PATH=data/keepsakes.sqlite3
