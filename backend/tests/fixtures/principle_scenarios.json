        "좋은 결과가 있을",
        "결국 행복해질",
        "틀림없이"
      ],
      "blame_or_character_judgment": [
        "의지가 부족",
        "게으른 사람",
        "무능한 사람",
        "성격 때문",
        "마음먹기 나름",
        "노력이 부족"
      ]
    },
    "empathy_repetition": {
      "aside_must_not_equal_opening_empathy": true,
      "exact_sentence_reuse_forbidden": true,
      "normalized_character_4gram_jaccard_max": 0.45,
      "longest_common_substring_characters_max": 14,
      "semantic_rule": "aside는 opening_empathy의 감정·상황 요약을 다시 말하는 문장이 아니라, 선택된 원리의 짧은 설명 또는 사회적 맥락을 새로 더해야 한다."
    },
    "assembled_message": {
      "segment_order": [
        "opening_empathy",
        "aside_text",
        "next_question"
      ],
      "opening_empathy_occurrences": 1,
      "aside_occurrences": 1,
      "next_question_occurrences": 1,
      "next_question_must_equal_fixture": true,
      "aside_must_not_modify_or_answer_next_question": true,
      "skip_case_order": [
        "opening_empathy",
        "next_question"
      ]
    }
  },
