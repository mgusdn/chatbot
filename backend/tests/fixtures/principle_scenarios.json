{
  "schema_version": "1.0",
  "description": "A 분기의 원리 검색·선택·말투·조립을 고정 검증하는 시나리오 모음. 실시간 문장 재작성 없이 principle_bank의 검수된 utterance를 그대로 사용하는 경로를 전제로 한다.",
  "runtime_contract": {
    "enabled_delivery_modes": [
      "named_pattern",
      "social_context"
    ],
    "disabled_delivery_modes": [
      "reference"
    ],
    "retrieval_candidate_limit": 3,
    "cooldown_turns": 3,
    "live_rewrite_enabled": false,
    "bank_utterance_must_be_verbatim": true,
    "turn_llm_call_delta": 0,
    "memory_retrieval_p95_ms_max": 20,
    "render_p95_ms_max": 5,
    "late_or_empty_result_behavior": "skip"
  },
  "automatic_validation": {
    "retrieval": {
      "use_case_pass_condition": "returned candidate_ids와 expected.candidate_ids_any_of의 교집합이 하나 이상이고 preferred_principle_id가 반환되면 1순위 또는 상위 3개 안에 있어야 한다.",
      "skip_case_pass_condition": "선택 결과가 principle_id=null, mode=none, aside_text=''여야 한다.",
      "candidate_count_max": 3,
      "candidate_ids_must_exist_in_bank": true,
      "recent_principle_ids_must_not_be_selected": true,
      "global_blocked_context_must_skip_before_render": true
    },
    "selection": {
      "allowed_modes": [
        "named_pattern",
        "social_context"
      ],
      "reference_mode_must_remain_disabled": true,
      "selected_mode_must_be_allowed_by_scenario": true,
      "selected_principle_must_be_in_expected_candidates": true,
      "low_confidence_behavior": "skip"
    },
    "aside_segment": {
      "must_equal_selected_bank_utterance": true,
      "sentence_count": 1,
      "character_length_min": 20,
      "character_length_max": 60,
      "question_mark_forbidden": true,
      "interrogative_ending_regex_forbidden": "(까요|나요|가요|신가요|인가요|어떠세요|어떻게요)[?？]?$",
      "question_lead_tokens_forbidden_at_start": [
        "왜 ",
        "무엇",
        "어떤 ",
        "어떻게 ",
        "언제 ",
        "누구"
      ],
      "advice_or_command_endings_forbidden": [
        "하세요",
        "해야 해요",
        "해야 합니다",
        "해보세요",
        "하셔야 해요",
        "하지 마세요"
      ],
      "lecture_markers_max": 1,
      "lecture_markers": [
        "심리학에서는",
        "연구에서는",
        "이론에서는",
        "첫째",
        "둘째",
        "셋째",
        "따라서",
        "결론적으로",
        "즉,"
      ],
      "named_term_mentions_max": 1,
      "citation_markers_forbidden": [
        "논문에 따르면",
        "연구 결과에 따르면",
        "출처:",
        "doi",
        "http://",
        "https://"
      ]
    },
    "forbidden_phrase_groups": {
      "fabricated_experience": [
        "저도 그래요",
        "저도 그랬",
        "제 경험상",
        "저희 애",
        "우리 아이",
