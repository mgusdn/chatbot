        "진단",
        "우울증",
        "ADHD",
        "강박증",
        "공황장애",
        "회피형",
        "불안형 애착",
        "트라우마 때문",
        "정상이에요",
        "비정상"
      ],
      "overoptimism_or_guarantee": [
        "다 잘될 거예요",
        "반드시 잘될",
        "분명히 잘될",
        "곧 나아질",
        "금방 괜찮아질",
        "걱정하지 마세요",
